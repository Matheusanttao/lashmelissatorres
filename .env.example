# Copie este arquivo para .env.local e preencha com os dados do seu projeto.

# --- Supabase (Project Settings → API) ---
# Use SOMENTE a chave pública "anon". NUNCA coloque a chave "service_role" aqui:
# tudo que começa com VITE_ fica visível no navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# --- Cloudinary (fotos do site, galeria, serviços e clientes) ---
# Dashboard → Settings → Product environment credentials (Cloud name)
# Dashboard → Settings → Upload → Upload presets → Add unsigned preset
VITE_CLOUDINARY_CLOUD_NAME=seu-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=seu-upload-preset-unsigned
